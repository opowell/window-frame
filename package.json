{
  "name": "window-frame",
  "version": "0.1.0",
  "description": "Panels in a recursively split grid for Vue 3 — tabbed, floating and draggable where you want them, with the whole layout held as data.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6012 --no-open",
    "build-storybook": "storybook build",
    "preversion": "npm run lint && npm run typecheck && npm run build && npm test",
    "version": "npm run build && git add dist",
    "release": "git push origin main --follow-tags"
  },
  "dependencies": {
    "menu-bar": "github:opowell/menu-bar#v0.1.0",
    "themes": "github:opowell/themes#v0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/vue3-vite": "^10.6.5",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "appfr": "github:opowell/appfr#v0.70.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "storybook": "^10.6.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.0",
    "vue3-sfc-loader": "^0.9.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "layout",
    "panels",
    "tabs",
    "docking",
    "window-manager",
    "split-view"
  ]
}
